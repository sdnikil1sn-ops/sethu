# Copy to .env with:  python scripts/init_env.py   (fills every CHANGE_ME with a random secret)
# .env is git-ignored. Never commit real secrets. In production, source these
# from Docker secrets or Vault instead of a file.

SETHU_ENVIRONMENT=dev
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
SETHU_OWNER_PASSWORD=CHANGE_ME
SETHU_APP_PASSWORD=CHANGE_ME
SETHU_AUDITOR_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

KEYCLOAK_ADMIN_USER=sethu-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Mail. The dev profile runs Mailpit (http://localhost:8025). In production
# point these at the AICTE/NIC SMTP relay.
SMTP_HOST=mailpit
SMTP_PORT=1025
