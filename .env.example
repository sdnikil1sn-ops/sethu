# Copy to .env with:  python scripts/init_env.py   (fills every CHANGE_ME with a random secret)
# .env is git-ignored. Never commit real secrets. In production, source these
# from Docker secrets or Vault instead of a file (docs/PRODUCTION-READINESS.md row 1).
# Every variable is described in docs/RUNBOOK.md, "Configuration reference".

# dev | test | prod. In prod the backend and worker refuse to start on a missing,
# placeholder or dev value, the seed loader and the demo-user import refuse to run.
SETHU_ENVIRONMENT=dev
# The address people open. Production: https://<host> (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8080
# Where the secret files are (complainant_keys.json in dev; every password in production).
SETHU_SECRETS_DIR=./secrets
# Production: where encrypted backups go (copy them off the host), how often, how long kept;
# and where the edge certificate is (python scripts/install_cert.py).
SETHU_BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
SETHU_CERTS_DIR=./infra/certs
# Semantic overlap signal (E5 vectors made by the ai-worker): off gives trigram only. Its threshold is the app
# setting ai.match.complaints.e5_threshold (docs/AI-PIPELINE.md, A3).
# SETHU_SEMANTIC_OVERLAP=true
# Audit-chain anchors: a write-once directory outside the database (docs/RUNBOOK.md).
SETHU_AUDIT_ANCHOR_DIR=./anchor
# Logs: JSON on stdout, one request id per request (docs/RUNBOOK.md, Observability).
# Default days to close a case when an admin has set none for its category (Admin > Deadlines).
# SETHU_SLA_DAYS=21
# Complaint intake: the spool folder (fallback channel), mounted into the worker; retry and limits.
SETHU_INTAKE_SPOOL_DIR=./spool
# SETHU_INTAKE_MAX_ATTEMPTS=6
# SETHU_INTAKE_RETRY_BASE_SECONDS=60
# SETHU_INTAKE_RETRY_MAX_SECONDS=3600
# SETHU_INTAKE_CLOCK_SKEW_SECONDS=300
# SETHU_INTAKE_RATE_PER_MINUTE=60
# SETHU_INTAKE_MAX_UPLOAD_BYTES=2000000
# SETHU_INTAKE_MAX_ROWS=5000

# Database and Redis passwords (dev). In production leave these EMPTY: every password is a file in
# SETHU_SECRETS_DIR (python scripts/init_secrets.py), and the backend refuses inline passwords.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
SETHU_OWNER_PASSWORD=CHANGE_ME
SETHU_APP_PASSWORD=CHANGE_ME
SETHU_AUDITOR_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Keycloak's bootstrap administrator (the master realm).
KEYCLOAK_ADMIN_USER=sethu-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# The backend's read-only client for sign-in events (Keycloak realm client `sethu-events`).
KEYCLOAK_EVENTS_SECRET=CHANGE_ME

# One password for the demo logins (rao, iyer, fernandes, menon, admin, das). Dev and demo
# only: production has no demo users. Needs 12+ characters with upper case, lower
# case and a digit, and no quote or backslash.
DEMO_USER_PASSWORD=Demo1-CHANGE_ME

# Mail. The dev profile runs Mailpit (http://localhost:8025). In production
# point these at the AICTE/NIC SMTP relay; Mailpit is refused there.
SMTP_HOST=mailpit
SMTP_PORT=1025
# none (Mailpit, dev only) | starttls (usually port 587) | tls (usually 465). Production refuses none.
# The relay's certificate is always verified, against the system CAs or SMTP_CA_FILE (a path inside
# the container). SMTP_USERNAME and SMTP_PASSWORD only if the relay needs a login.
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CA_FILE=
# Production only: the sender of alert mail. Not a .test address.
ALERT_FROM=
