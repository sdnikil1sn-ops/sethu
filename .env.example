# Copy to .env with:  python scripts/init_env.py   (fills every CHANGE_ME with a random secret)
# .env is git-ignored. Never commit real secrets. In production, source these
# from Docker secrets or Vault instead of a file (docs/PRODUCTION-READINESS.md row 1).
# Every variable is described in docs/RUNBOOK.md, "Configuration reference".

# dev | test | prod. In prod the backend and worker refuse to start on a missing,
# placeholder or dev value, the seed loader and the demo-user import refuse to run.
SETHU_ENVIRONMENT=dev
# The address people open. Production: https://<host> (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8080

# Database and Redis passwords: 16+ random characters in production.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
SETHU_OWNER_PASSWORD=CHANGE_ME
SETHU_APP_PASSWORD=CHANGE_ME
SETHU_AUDITOR_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Keycloak's bootstrap administrator (the master realm).
KEYCLOAK_ADMIN_USER=sethu-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# One password for the demo logins (rao, iyer, fernandes, menon, admin, das). Dev and demo
# only: production has no demo users. Needs 12+ characters with upper case, lower
# case and a digit, and no quote or backslash.
DEMO_USER_PASSWORD=Demo1-CHANGE_ME

# Mail. The dev profile runs Mailpit (http://localhost:8025). In production
# point these at the AICTE/NIC SMTP relay; Mailpit is refused there.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Production only: the sender of alert mail. Not a .test address.
ALERT_FROM=
